[internationalization]

locale/fallback="en"

[layer_names]

2d_physics/layer_1="terrain"
2d_physics/layer_2="vehicle"
2d_physics/layer_3="driver"
2d_physics/layer_4="pickups"
2d_physics/layer_5="ui"

[physics]

2d/default_gravity=420.0
2d/default_gravity_vector=Vector2(0, 1)

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.06, 0.08, 0.15, 1)
anti_aliasing/quality/msaa_2d=0
particles/blur/partical_blur_mode=0
